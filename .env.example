# MongoDB Atlas or Local MongoDB Connection
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/recircle?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/recircle
MONGODB_DB=recircle

NEXT_PUBLIC_APP_URL=http://localhost:3001
PORT=3001

# Superadmin Private Credentials
ADMIN_EMAIL=admin@recircle.org
ADMIN_PASSWORD=change_this_password
ADMIN_JWT_SECRET=super_secret_admin_jwt_key
